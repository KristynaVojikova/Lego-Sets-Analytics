{
  "datasets": [
    {
      "name": "a9c9d882",
      "displayName": "figurky_hledani",
      "queryLines": [
        "SELECT\r\n",
        "    nazev_figurky,\r\n",
        "    obrazek_figurky,\r\n",
        "    cislo_figurky,\r\n",
        "    pocet_kusu,\r\n",
        "    nazev_stavebnice,\r\n",
        "    cislo_setu,\r\n",
        "    tema,\r\n",
        "    rok_vydani,\r\n",
        "    puvodni_cena_eur,\r\n",
        "    set_img_url\r\n",
        "FROM workspace.lego_gold.minifigs_in_sets\r\n",
        "WHERE nazev_figurky ILIKE CONCAT('%', :hledat_figurku, '%')\r\n",
        "ORDER BY nazev_figurky, rok_vydani"
      ],
      "parameters": [
        {
          "displayName": "hledat_figurku",
          "keyword": "hledat_figurku",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "%"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "27feeb94",
      "displayName": "figurky_katalog",
      "queryLines": [
        "SELECT\r\n",
        "    nazev_figurky,\r\n",
        "    obrazek_figurky,\r\n",
        "    tema,\r\n",
        "    v_kolika_setech,\r\n",
        "    prvni_rok,\r\n",
        "    posledni_rok,\r\n",
        "    sety\r\n",
        "FROM workspace.lego_gold.minifigs_catalog\r\n",
        "WHERE nazev_figurky ILIKE CONCAT('%', :hledat_figurku, '%')\r\n",
        "ORDER BY nazev_figurky, prvni_rok, v_kolika_setech DESC"
      ],
      "parameters": [
        {
          "displayName": "hledat_figurku",
          "keyword": "hledat_figurku",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "%"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5a0f2c2f",
      "displayName": "star_wars_sety",
      "queryLines": [
        "SELECT\r\n",
        "    cislo_setu,\r\n",
        "    nazev_stavebnice,\r\n",
        "    rok_vydani,\r\n",
        "    cena_czk,\r\n",
        "    pocet_dilku,\r\n",
        "    pocet_figurek,\r\n",
        "    set_img_url,\r\n",
        "    COUNT(*)                                             AS pocet_setu,\r\n",
        "    ROUND(cena_czk / NULLIF(pocet_dilku, 0), 2)          AS cena_za_dilek_czk,\r\n",
        "    CASE WHEN cena_czk IS NOT NULL THEN pocet_dilku END  AS dilky_s_cenou,\r\n",
        "    CASE WHEN ma_cenu THEN 'S cenou' ELSE 'Bez ceny' END AS cena_uvedena\r\n",
        "FROM workspace.lego_gold.sets_overview\r\n",
        "WHERE tema = 'Star Wars'\r\n",
        "    AND rok_vydani >= 2006\r\n",
        "GROUP BY cislo_setu, nazev_stavebnice, rok_vydani, cena_czk, pocet_dilku, pocet_figurek, set_img_url, ma_cenu\r\n",
        "ORDER BY rok_vydani DESC, pocet_dilku DESC, pocet_figurek DESC"
      ],
      "columns": [
        {
          "displayName": "cena_za_dilek_vazena",
          "description": "",
          "expression": "  SUM(cena_czk) / SUM(dilky_s_cenou)"
        }
      ]
    }
  ],
